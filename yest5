HT.Mut = function(s)
    if s.Name == "NVHS" or s:GetAttribute("NVHS") then return end
    if not HT.Vols[s] then
        HT.Vols[s] = s.Volume
        s:GetPropertyChangedSignal("Volume"):Connect(function()
            if HT.On and s.Volume > 0 then HT.Vols[s] = s.Volume s.Volume = 0 end
        end)
    end
    s.Volume = HT.On and 0 or (HT.Vols[s] or 0.5)
end
HT.Upd = function() for s in pairs(HT.Vols) do if s and s.Parent then HT.Mut(s) end end end
HT.Clr = function() for _, c in ipairs(HT.Conns) do pcall(function() c:Disconnect() end) end table.clear(HT.Conns) table.clear(HT.Tls) end
HT.Stp = function()
    for s in pairs(HT.Act) do if s then pcall(function() s:Stop() s:Destroy() end) end end
    table.clear(HT.Act)
    pcall(function() for _, o in ipairs(workspace:GetDescendants()) do if o:IsA("Sound") and o:GetAttribute("NVHS") then o:Stop() o:Destroy() end end end)
end
HT.Ply = function()
    if not HT.On or HT.Id == "" then return end
    local g, s = HT.Gen, Instance.new("Sound")
    s.Name, s.SoundId, s.Volume, s.PlaybackSpeed, s.Looped, s.Parent = "NVHS", HT.Id, math.clamp(HT.Vol, 0, 5), 1, false, workspace
    s:SetAttribute("NVHS", true) HT.Act[s] = true
    s.Ended:Connect(function() HT.Act[s] = nil pcall(function() s:Destroy() end) end)
    if g ~= HT.Gen then HT.Act[s] = nil pcall(function() s:Stop() s:Destroy() end) return end
    pcall(function() s:Play() end)
end
HT.Prc = function(t)
    if not t:IsA("Tool") or HT.Tls[t] then return end
    HT.Tls[t] = true
    for _, d in ipairs(t:GetDescendants()) do if d:IsA("Sound") then HT.Mut(d) end end
    t.DescendantAdded:Connect(function(d) if d:IsA("Sound") then task.defer(function() HT.Mut(d) end) end end)
    local a = t:FindFirstChild("Ammo")
    if a and (a:IsA("IntValue") or a:IsA("NumberValue")) then
        local l = a.Value
        table.insert(HT.Conns, a:GetPropertyChangedSignal("Value"):Connect(function()
            if HT.On and a.Value < l then HT.Ply() end
            l = a.Value
        end))
    end
end
HT.Hk = function(c)
    for _, k in ipairs(c:GetChildren()) do HT.Prc(k) end
    table.insert(HT.Conns, c.ChildAdded:Connect(function(k) if HT.On then task.wait() HT.Prc(k) end end))
end
task.spawn(function()
