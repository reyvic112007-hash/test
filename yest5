local function finishStompCamera()
    -- Restore any in-flight teleport before changing camera state. This also
    -- prevents a delayed RenderStepped callback from causing a release flick.
    local frame = stompState.frame
    if frame then
        if frame.root and frame.root.Parent then
            frame.root.CFrame = frame.oldCFrame
        end
        if frame.humanoid and frame.humanoid.Parent then
            frame.humanoid.CameraOffset = frame.cameraOffset
        end
        stompState.frame = nil
    end

    local savedHum = stompState.savedHumanoid
    if savedHum and savedHum.Parent and stompState.savedCameraOffset ~= nil then
        savedHum.CameraOffset = stompState.savedCameraOffset
    end

    local currentHum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass('Humanoid')
    local previousSubject = stompState.savedCameraSubject
    if previousSubject and previousSubject.Parent and previousSubject ~= stomp_anchor then
        Camera2.CameraSubject = previousSubject
    elseif currentHum then
        Camera2.CameraSubject = currentHum
    end

    stompState.savedCameraSubject = nil
    stompState.savedCameraOffset = nil
    stompState.savedHumanoid = nil
end

local function stopStompAction()
    stompState.active = false
    stompState.targetCFrame = nil
    stompState.oldCFrame = nil
    finishStompCamera()
    togglePhysicsRep(false)
end

function togglePhysicsRep(state)
    if not sethiddenproperty then return end
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if root then
        pcall(function()
            if state then sethiddenproperty(root, "PhysicsRepRootPart", nil)
            else sethiddenproperty(root, "PhysicsRepRootPart", root) end
        end)
    end
end

function handleVisualizer()
    if stompState.visual and stompState.active and stompState.targetCFrame then
        if not visualizerDummy then
            local c = LocalPlayer.Character
            if c then
                c.Archivable = true
                visualizerDummy = c:Clone()
                visualizerDummy.Name = "Stomp_Visualizer"
                for _, v in ipairs(visualizerDummy:GetDescendants()) do
                    if v:IsA("BasePart") or v:IsA("Decal") then
                        v.Transparency = 0.5
                        if v:IsA("BasePart") then
                            v.Material = Enum.Material.ForceField
                            v.Color = Color3.fromRGB(255,0,0)
                            v.CanCollide = false
                            v.Anchored = true
                        end
                    elseif v:IsA("Script") or v:IsA("LocalScript") then
                        v:Destroy()
                    end
                end
                visualizerDummy.Parent = workspace
            end
        end
        if visualizerDummy then visualizerDummy:PivotTo(stompState.targetCFrame) end
    else
        if visualizerDummy then visualizerDummy:Destroy() visualizerDummy = nil end
    end
end

RunService.Heartbeat:Connect(function()
    if stompState.active and stompState.targetCFrame then
        -- Never stack a second temporary teleport while the previous one is
        -- still waiting for RenderStepped.
        if stompState.frame then return end

        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild('HumanoidRootPart')
        local hum = char and char:FindFirstChildOfClass('Humanoid')
        if not root or not hum then return end

        local oldCFrame = root.CFrame
        local targetCFrame = stompState.targetCFrame
        local rotation = oldCFrame - oldCFrame.Position
        local frame = {
            root = root,
            humanoid = hum,
            oldCFrame = oldCFrame,
            cameraOffset = hum.CameraOffset,
        }
        stompState.frame = frame
        stompState.oldCFrame = oldCFrame

        -- Keep the camera focus at the original world position while the root
        -- temporarily moves to the stomp target.
        hum.CameraOffset = rotation:VectorToObjectSpace(oldCFrame.Position - targetCFrame.Position)
        stomp_anchor.CFrame = oldCFrame
        root.CFrame = CFrame.new(targetCFrame.Position) * rotation
        handleVisualizer()

        RunService.RenderStepped:Wait()
        if stompState.frame == frame then
            if root and root.Parent then root.CFrame = oldCFrame end
            if hum and hum.Parent then hum.CameraOffset = frame.cameraOffset end
            stompState.frame = nil
        end
    else
        handleVisualizer()
    end
end)

