local function getDynamicTarget()
    local mouse = LocalPlayer:GetMouse()
    local mousePos = Vector2.new(mouse.X, mouse.Y)
    local best, bestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local char = p.Character
            local tpart = char:FindFirstChild("Head") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            local be = char:FindFirstChild("BodyEffects")
            local ko = be and be:FindFirstChild("K.O") and be["K.O"].Value == true
            if tpart and hum and hum.Health > 0 and not ko then
                local sp, onScreen = Camera2:WorldToViewportPoint(tpart.Position)
                if onScreen then
                    local d = (mousePos - Vector2.new(sp.X, sp.Y)).Magnitude
                    if d < bestDist then bestDist, best = d, p end
                end
            end
        end
    end
    return best, bestDist
end
local function cursorDistanceTo(player)
    if not player or not player.Character then return math.huge end
    local char = player.Character
    local tpart = char:FindFirstChild("Head") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
    if not tpart then return math.huge end
    local mouse = LocalPlayer:GetMouse()
    local sp, onScreen = Camera2:WorldToViewportPoint(tpart.Position)
    if not onScreen then return math.huge end
    return (Vector2.new(mouse.X, mouse.Y) - Vector2.new(sp.X, sp.Y)).Magnitude
end
local function fireAtTarget(target)
    if not target or not target.Character then return end
    local tHead = target.Character:FindFirstChild('Head')
    if not tHead then return end
    local c = LocalPlayer.Character
    if not c then return end
    local me = ReplicatedStorage:FindFirstChild("MainEvent")
    if not me then return end
    local tool = c:FindFirstChildOfClass("Tool")
    if not (tool and tool:FindFirstChild('Handle') and tool:FindFirstChild('Ammo')) then
        tool = nil
        for _, t in ipairs(c:GetChildren()) do
            if t:IsA('Tool') and t:FindFirstChild('Handle') and t:FindFirstChild('Ammo') then tool = t break end
        end
    end
    if not tool then return end
    me:FireServer('ShootGun', tool.Handle, tool.Handle.CFrame.Position, tHead.Position, tHead, Vector3.new(0, 0, -1))
end
local function stopDynamicTP()
    dynamicState.active, dynamicState.targetCFrame, dynamicState.targetPlayer = false, nil, nil
    local frame = dynamicState.frame
    if frame then
        if frame.root and frame.root.Parent then frame.root.CFrame = frame.oldCFrame end
        if frame.humanoid and frame.humanoid.Parent then frame.humanoid.CameraOffset = frame.cameraOffset end
        if frame.oldCFrame then dynamic_anchor.CFrame = frame.oldCFrame end
        dynamicState.frame = nil
    end
    local char = LocalPlayer.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if humanoid and dynamicState.savedCameraOffset ~= nil then humanoid.CameraOffset = dynamicState.savedCameraOffset end
    if Camera2 then
        local previousSubject = dynamicState.savedCameraSubject
        if previousSubject and previousSubject ~= dynamic_anchor and previousSubject.Parent then
            Camera2.CameraSubject = previousSubject
        elseif humanoid then
            Camera2.CameraSubject = humanoid
        end
    end
    dynamicState.savedCameraSubject, dynamicState.savedCameraOffset = nil, nil
    togglePhysicsRep(false)
end
local function startDynamicTP()
    if dynamicState.active then return end
    local target = getDynamicTarget()
    if not target or not target.Character then Notify("Ragebot: no target", 2) return end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid then Notify("Ragebot: character not ready", 2) return end
    dynamicState.savedCameraSubject, dynamicState.savedCameraOffset = Camera2.CameraSubject, humanoid.CameraOffset
    dynamicState.targetPlayer, dynamicState.active = target, true
    dynamic_anchor.CFrame = root.CFrame
    togglePhysicsRep(true)
    Camera2.CameraSubject = humanoid
    Notify("Target: " .. target.DisplayName, 2, target.UserId)
end
RunService.Heartbeat:Connect(function()
    if not dynamicState.active or dynamicState.frame then return end
    local newTarget, newDist = getDynamicTarget()
    if newTarget then
        local cur = dynamicState.targetPlayer
        if newTarget ~= cur then
            local curHum = cur and cur.Character and cur.Character:FindFirstChildOfClass("Humanoid")
            local curValid = curHum and curHum.Health > 0
            local curDist = curValid and cursorDistanceTo(cur) or math.huge
            if not curValid or (curDist - newDist) > dynamicState.switchThreshold then
                dynamicState.targetPlayer = newTarget
                Notify("Target: " .. newTarget.DisplayName, 2, newTarget.UserId)
            end
        end
    end
    local target = dynamicState.targetPlayer
    local tChar = target and target.Character
    local targetPart = tChar and (tChar:FindFirstChild("Head") or tChar:FindFirstChild("UpperTorso") or tChar:FindFirstChild("Torso") or tChar:FindFirstChild("HumanoidRootPart"))
    local targetHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
    local be = tChar and tChar:FindFirstChild("BodyEffects")
    local ko = be and be:FindFirstChild("K.O") and be["K.O"].Value == true
    if not targetPart or not targetHum or targetHum.Health <= 0 or ko then
        dynamicState.targetPlayer = nil
        if not newTarget then stopDynamicTP() end
        return
    end
    local meChar = LocalPlayer.Character
    local root = meChar and meChar:FindFirstChild("HumanoidRootPart")
    local humanoid = meChar and meChar:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid then stopDynamicTP() return end
    dynamicState.targetCFrame = CFrame.new(targetPart.Position + Vector3.new(0, dynamicState.offsetHeight, 0))
    local oldCFrame = root.CFrame
    local rotation = oldCFrame - oldCFrame.Position
    local oldPos = oldCFrame.Position
    local tpPos = dynamicState.targetCFrame.Position
    local oldCameraOffset = humanoid.CameraOffset
    local frame = {root=root,humanoid=humanoid,oldCFrame=oldCFrame,cameraOffset=oldCameraOffset}
    dynamicState.frame = frame
    humanoid.CameraOffset = rotation:VectorToObjectSpace(oldPos - tpPos)
    dynamic_anchor.CFrame = oldCFrame
    root.CFrame = CFrame.new(tpPos) * rotation
    local now = tick()
    if now - dynamicState.lastFire >= dynamicState.fireCooldown then
        dynamicState.lastFire = now
        fireAtTarget(dynamicState.targetPlayer)
    end
    RunService.RenderStepped:Wait()
    if dynamicState.frame == frame then
        if root and root.Parent then root.CFrame = oldCFrame end
        if humanoid and humanoid.Parent then humanoid.CameraOffset = oldCameraOffset end
        dynamicState.frame = nil
    end
end)
