function applyChar(char)
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            if not colorState.c_orig[p] then colorState.c_orig[p] = { Material = p.Material, Color = p.Color } end
            p.Material = Enum.Material.ForceField
            p.Color = colorState.c_color
        end
    end
end
function applyGuns(char)
    if not char then return end
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            for _, p in ipairs(tool:GetDescendants()) do
                if p:IsA("BasePart") then
                    if not colorState.g_orig[p] then colorState.g_orig[p] = { Material = p.Material, Color = p.Color } end
                    p.Material = Enum.Material.ForceField
                    p.Color = colorState.g_color
                end
            end
        end
    end
end
function restoreColors(tbl)
    for p, d in pairs(tbl) do
        if p and p.Parent and p:IsA("BasePart") then
            p.Material = d.Material
            p.Color = d.Color
        end
    end
    table.clear(tbl)
end
function startGunWatcher()
    if colorState.g_conn then colorState.g_conn:Disconnect() colorState.g_conn = nil end
    if colorState.g_addConn then colorState.g_addConn:Disconnect() colorState.g_addConn = nil end
    local char = LocalPlayer.Character
    if not char then return end
    applyGuns(char)
    colorState.g_addConn = char.ChildAdded:Connect(function(child)
        if colorState.g_on and child:IsA("Tool") then
            task.wait()
            if colorState.g_on and LocalPlayer.Character == char then applyGuns(char) end
        end
    end)
    colorState.g_conn = LocalPlayer.CharacterAdded:Connect(function(newChar)
        task.wait(1)
        if colorState.g_on and LocalPlayer.Character == newChar then applyGuns(newChar) end
    end)
end

