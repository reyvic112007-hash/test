Legit:AddToggle("NoSpread", {
    Text = "No Spread", Default = false,
    Callback = function(state)
        getgenv().XZQW_NoSpread = state

        if state then
            Notify("No Spread Enabled", 2)

            if getgenv()._ns_shootOrig and getgenv()._ns_version ~= "v4-converge" then
                pcall(function()
                    local GH = require(game.ReplicatedStorage.Modules.GunHandler)
                    if GH and getgenv()._ns_shootOrig then GH.shoot = getgenv()._ns_shootOrig end
                end)
                getgenv()._ns_shootOrig = nil
            end

            if not getgenv()._ns_shootOrig then
                local ok, err = pcall(function()
                    local GH = require(game.ReplicatedStorage.Modules.GunHandler)
                    if type(GH) ~= "table" or type(GH.shoot) ~= "function" then
                        error("GunHandler.shoot is not a function")
                    end
                    getgenv()._ns_shootOrig = GH.shoot
                    getgenv()._ns_version    = "v4-converge"

                    -- Cache SA target briefly so 5 pellets don't lose lock mid-burst
                    local _lastSATarget = nil
                    local _lastSATime   = 0
                    local CACHE_TIME    = 0.20   -- 200ms

                    local function resolveSA()
                        local candidates = {
                            getgenv().SA_state,
                            getgenv().SA,
                            _G and _G.SA,
                            shared and shared.SA,
                        }
                        for _, cand in ipairs(candidates) do
                            if type(cand) == "table" and cand.on ~= nil and cand.fov ~= nil then
                                return cand
                            end
                        end
                        return nil
                    end

                    GH.shoot = function(t)
                        if not getgenv().XZQW_NoSpread then
                            return getgenv()._ns_shootOrig(t)
                        end
                        local pct = tonumber(getgenv().XZQW_NoSpreadAmount) or 0
                        if pct >= 100 then
                            return getgenv()._ns_shootOrig(t)
                        end
                        if type(t) ~= "table" or not t.ForcedOrigin or not t.AimPosition then
                            return getgenv()._ns_shootOrig(t)
                        end

                        local origin = t.ForcedOrigin
                        local convergenceDir = nil

                        -- PRIORITY 1: SA target (with short cache)
                        local sa = resolveSA()
                        if sa and (sa.on or sa.forcePart) then
                            local tp = sa.forcePart or sa.locked
                            if tp and tp.Parent then
                                _lastSATarget = tp
                                _lastSATime   = os.clock()
                            elseif _lastSATarget
                                   and _lastSATarget.Parent
                                   and (os.clock() - _lastSATime) < CACHE_TIME then
                                tp = _lastSATarget   -- use cached target across burst
                            end
                            if tp and tp.Parent then
                                convergenceDir = (tp.Position - origin).Unit
                            end
                        end

                        -- PRIORITY 2: mouse ray fallback
                        if not convergenceDir then
                            local cam  = workspace.CurrentCamera
                            local plr  = game.Players.LocalPlayer
                            local char = plr and plr.Character
                            if not (cam and char) then
                                return getgenv()._ns_shootOrig(t)
                            end
                            local mouse = plr:GetMouse()
                            local ray   = cam:ScreenPointToRay(mouse.X, mouse.Y)

                            local params = RaycastParams.new()
                            params.FilterType = Enum.RaycastFilterType.Exclude
                            params.FilterDescendantsInstances = {char, cam}
                            params.IgnoreWater = true

                            local result = workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
                            local targetPos = result and result.Position
                                or (ray.Origin + ray.Direction * 2000)
                            convergenceDir = (targetPos - origin).Unit
                        end

                        if not convergenceDir then
                            return getgenv()._ns_shootOrig(t)
                        end

                        -- Blend by slider
                        local aimDir     = (t.AimPosition - origin).Unit
                        local blendedDir = convergenceDir:Lerp(aimDir, pct / 100).Unit
                        t.AimPosition = origin + blendedDir * 200

                        return getgenv()._ns_shootOrig(t)
                    end
                end)
                if ok then
                    print("[NoSpread] v4-converge installed — force-converges on SA target")
                else
                    warn("[NoSpread] patch failed: "..tostring(err))
                end
            else
                print("[NoSpread] v4-converge already installed")
            end

        else
            Notify("No Spread Disabled", 1.5)
        end
    end
})
