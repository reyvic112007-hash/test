local GuiService = game:GetService("GuiService")
local IS_MOBILE = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

-- Returns the point the silent-aim FOV is measured from.
-- PC  -> mouse position
-- Mobile -> exact center of the viewport (no cursor exists)
local function getAimPoint()
    if IS_MOBILE then
        local vs = Camera2.ViewportSize
        return Vector2.new(vs.X * 0.5, vs.Y * 0.5)
    end
    return UserInputService:GetMouseLocation()
end

-- Places the FOV ring. On mobile we compensate for the topbar inset
-- because fovGui.IgnoreGuiInset is true (offset 0,0 = real screen top-left).
local function getRingPosition(p)
    if IS_MOBILE then
        local inset = GuiService:GetGuiInset()
        return UDim2.fromOffset(p.X + inset.X, p.Y + inset.Y)
    end
    return UDim2.fromOffset(p.X, p.Y)
end

