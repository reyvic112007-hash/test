hitboxSize, hitboxColor, hitboxEnabled, hitboxVisual = 10, Color3.fromRGB(255,0,255), false, false
origMat, origCol = {}, {}

function getHRP(char) return char and char:FindFirstChild("HumanoidRootPart") end
function isKO(char)
    local be = char and char:FindFirstChild("BodyEffects")
    local ko = be and be:FindFirstChild("K.O")
    return ko and ko.Value
end

function updateHitbox(char)
    local hrp = getHRP(char)
    if not hrp then return end
    if not hitboxEnabled or isKO(char) then
        hrp.Size = Vector3.new(2,1,2)
        hrp.Transparency = 1
        hrp.CanCollide = true
        if origMat[hrp] then
            hrp.Material, hrp.Color = origMat[hrp], origCol[hrp]
            origMat[hrp], origCol[hrp] = nil, nil
        end
        return
    end
    hrp.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
    hrp.Transparency = 0
    hrp.CanCollide = false
    if not origMat[hrp] then origMat[hrp], origCol[hrp] = hrp.Material, hrp.Color end
    hrp.Material, hrp.Color = hitboxVisual and Enum.Material.ForceField or origMat[hrp], hitboxVisual and hitboxColor or origCol[hrp]
end

function refreshHitboxes()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then updateHitbox(p.Character) end
    end
end

