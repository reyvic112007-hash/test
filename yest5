                    _G.MyActiveAction = "Stomping Target"
                    local stompPart = tChar:FindFirstChild("UpperTorso") or tChar:FindFirstChild("LowerTorso") or tRoot
                    root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
                    root.CFrame = CFrame.new(stompPart.Position + Vector3.new(0, 2.9, 0)) * CFrame.Angles(0, math.rad(tick() * 360), 0)
                    ReplicatedStorage.MainEvent:FireServer("Stomp")
                    return
                end
                if #equippedGuns == 0 then
                    _G.MyActiveAction = "Equip any Gun Weapon"
                    root.CFrame = makeVoidCFrame()
                    return
                end
                _G.MyActiveAction = "Shooting Target"
                local ADVANCE_TIME = tonumber(T.GunVelocityPrediction) or 0.1
                local upperTorso = tChar:FindFirstChild("UpperTorso") or tChar:FindFirstChild("Torso") or tRoot
                local head = tChar:FindFirstChild("Head")
                local aimPart = head or upperTorso
                local currentTime = tick()
                local lastPos, lastTime = T.LastPositions[target.UserId], T.LastTimes[target.UserId]
                local targetVel = Vector3.zero
                if lastPos and lastTime then
                    local dt = currentTime - lastTime
                    if dt > 0.001 then
                        local measuredVel = (upperTorso.Position - lastPos) / dt
                        targetVel = measuredVel.Magnitude < 200 and measuredVel or upperTorso.AssemblyLinearVelocity
                    end
                else
                    targetVel = upperTorso.AssemblyLinearVelocity
                end
                if T.LastVel[target.UserId] then targetVel = T.LastVel[target.UserId]:Lerp(targetVel, 0.4) end
                T.LastVel[target.UserId] = targetVel
                T.LastPositions[target.UserId], T.LastTimes[target.UserId] = upperTorso.Position, currentTime
                local flatVel = Vector3.new(targetVel.X, 0, targetVel.Z)
                local advanceOffset = flatVel * ADVANCE_TIME
                if advanceOffset.Magnitude > 30 then advanceOffset = advanceOffset.Unit * 30 end
                local offset = Vector3.new(math.random(-20, 20), math.random(-10, 10), math.random(-20, 20))
                local randomRotation = CFrame.Angles(math.rad(math.random(0, 360)), math.rad(math.random(0, 360)), math.rad(math.random(0, 360)))
                root.CFrame = CFrame.new(tRoot.Position + advanceOffset + offset) * randomRotation
                root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
                local mainEvent = ReplicatedStorage:FindFirstChild("MainEvent")
                if mainEvent then
                    local aimPoint = aimPart.Position + advanceOffset
                    for _, gun in ipairs(equippedGuns) do
                        if gun.Handle then mainEvent:FireServer("ShootGun", gun.Handle, gun.Handle.CFrame.Position, aimPoint, aimPart, Vector3.new(0, 0, -1)) end
                    end
                end
            end)
        end
        local root0 = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if root0 then T.originalCFrame = root0.CFrame end
        Notify("Gun Auto Kill Active", 2)
        _G.MyActiveAction = "Gun Core Loop"
        T.LastPositions, T.LastTimes, T.LastVel = T.LastPositions or {}, T.LastTimes or {}, T.LastVel or {}
        T._charDiedConn = LocalPlayer.CharacterRemoving:Connect(function() T.buyingGunsState = false T.AutoAmmoBusy = false end)
        T._charAddedConn = LocalPlayer.CharacterAdded:Connect(function(char)
            cleanupGunKillState()
            T.originalCFrame = nil
            T.LastPositions, T.LastTimes, T.LastVel = {}, {}, {}
            task.wait(1.5)
            if not T.GunAutoKillEnabled then return end
            task.spawn(function()
                buyRifleThenAug()
                forceEquipRifleAndAug()
                startGunHeartbeat()
                _G.MyActiveAction = "Gun Core Loop"
                Notify("Respawned — kill loop restarted", 2)
            end)
        end)
        task.spawn(function()
            buyRifleThenAug()
            forceEquipRifleAndAug()
            startGunHeartbeat()
            _G.MyActiveAction = "Gun Core Loop"
            Notify("Rifle + AUG ready, starting kill loop", 2)
        end)
    end
})
