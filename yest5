function tpwheels()
    local bike = workspace.OldVehicles and workspace.OldVehicles:FindFirstChild(LocalPlayer.Name.."BIKE")
    if bike and bike:FindFirstChild("Seat") then
        local sp = bike.Seat.Position
        for _, w in ipairs({ "LBWheel","LTWheel","RBWheel","RTWheel" }) do
            if bike:FindFirstChild(w) then bike[w].CFrame = CFrame.new(sp) end
        end
    end
end

function findMatchingPlayer(s)
    if s == "" then return end
    local l = s:lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and (p.Name:lower():find(l,1,true) or p.DisplayName:lower():find(l,1,true)) then return p end
    end
end

function executeKidnapStep(target, destCF, name)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") or not target or not target.Character or not target.Character:FindFirstChild("UpperTorso") then return end
    kidnapState.tpCFrame = destCF
    local bike = workspace.OldVehicles and workspace.OldVehicles:FindFirstChild(LocalPlayer.Name.."BIKE")
    if not bike then
        if char:FindFirstChildWhichIsA('Tool') then char:FindFirstChildWhichIsA('Tool').Parent = LocalPlayer.Backpack end
        local shop = findShopItem("[FoodsCart]")
        if shop and shop:FindFirstChild("Head") and shop:FindFirstChild("ClickDetector") then
            char.HumanoidRootPart.CFrame = shop.Head.CFrame * CFrame.new(0,-3.1,0)
            fireclickdetector(shop.ClickDetector, 0)
            if os.clock() - kidnapState.lastAlert > 3 then
                kidnapState.lastAlert = os.clock()
                Notify("Cart TP: Replacing cart...", 2)
            end
        end
        return
    end
    local vs, ss = bike:FindFirstChild('VehicleSeat'), bike:FindFirstChild('Seat')
    if not vs or not ss then return end
    if not vs:FindFirstChildWhichIsA("Weld") then
        char.HumanoidRootPart.CFrame = vs.CFrame
        return
    end
    if not ss:FindFirstChildWhichIsA("Weld") and not kidnapState.alreadySat then
        ss.CFrame = target.Character.UpperTorso.CFrame
        pcall(tpwheels)
    elseif ss:FindFirstChildWhichIsA("Weld") or kidnapState.alreadySat then
        if not kidnapState.alreadySat then
            kidnapState.alreadySat = true
            Notify("Secured target: "..target.Name, 2)
        end
        if ss:FindFirstChildWhichIsA('Weld') then
            ss.CFrame = kidnapState.tpCFrame
            vs.CFrame = kidnapState.tpCFrame
            pcall(tpwheels)
        else
            if not kidnapState.loopCreated then
                kidnapState.loopCreated = true
                if kidnapState.conn then kidnapState.conn:Disconnect() kidnapState.conn = nil end
                task.spawn(function()
                    Notify("Unloading passenger...", 1.5)
                    while vs:FindFirstChildWhichIsA("Weld") and kidnapState.amount < 0.5 do
                        ss.CFrame = kidnapState.tpCFrame
                        vs.CFrame = kidnapState.tpCFrame
                        pcall(tpwheels)
                        kidnapState.amount = kidnapState.amount + task.wait()
                    end
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum then hum.Sit = false end
                    task.wait(0.1)
                    char.HumanoidRootPart.CFrame = char.HumanoidRootPart.CFrame + Vector3.new(0,5,0)
                    kidnapState.active = false
                    kidnapState.alreadySat = false
                    kidnapState.loopCreated = false
                    kidnapState.amount = 0
                    Notify("Delivered "..target.Name.." successfully!", 2)
                end)
            end
        end
    end
end

function startKidnap()
    if kidnapState.active then return end
    local victim = findMatchingPlayer(kidnapState.victimInput)
    local dest = findMatchingPlayer(kidnapState.destInput)
    if not victim then Notify("Error: Victim not found.", 2) return end
    if not dest then Notify("Error: Destination not found.", 2) return end
    if victim == dest then Notify("Error: Cannot target self.", 2) return end
    local destRoot = dest.Character and dest.Character:FindFirstChild("HumanoidRootPart")
    if not destRoot then Notify("Error: Destination missing RootPart.", 2) return end
    kidnapState.active = true
    kidnapState.alreadySat = false
    kidnapState.loopCreated = false
    kidnapState.amount = 0
    kidnapState.tpCFrame = nil
    Notify("Bringing "..victim.Name.." to "..dest.Name, 2)
    kidnapState.conn = RunService.Heartbeat:Connect(function()
        if not kidnapState.active then
            if kidnapState.conn then kidnapState.conn:Disconnect() kidnapState.conn = nil end
            return
        end
        if not victim.Parent then
            kidnapState.active = false
            if kidnapState.conn then kidnapState.conn:Disconnect() kidnapState.conn = nil end
            Notify("Interrupted: Target left game.", 2)
            return
        end
        local cur = dest.Character and dest.Character:FindFirstChild("HumanoidRootPart") and dest.Character.HumanoidRootPart.CFrame or destRoot.CFrame
        executeKidnapStep(victim, cur, "@"..dest.Name)
    end)
end

