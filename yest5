function saVisible(part)
    if not SA.noWall then return true end
    if not Camera2 or not part then return false end
    local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildWhichIsA("Tool")
    local origin = (tool and tool:FindFirstChild("Handle") and tool.Handle.Position) or Camera2.CFrame.Position
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LocalPlayer.Character, Camera2 }
    params.IgnoreWater = true
    local hit = workspace:Raycast(origin, part.Position - origin, params)
    if not hit then return true end
    return hit.Instance:IsDescendantOf(part.Parent)
end

function saPart(character)
    for _, name in ipairs(SA.parts) do
        local p = character:FindFirstChild(name)
        if p then return p end
    end
    return character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head")
end

-- ============================================================
-- GUNHANDLER HOOK (uses no executor-exclusive functions)
-- ============================================================
pcall(function()
    if not (ReplicatedStorage and ReplicatedStorage:FindFirstChild("Modules")) then return end
    if not ReplicatedStorage.Modules:FindFirstChild("GunHandler") then return end

    local gh = require(ReplicatedStorage.Modules.GunHandler)
    if not (gh and gh.getAim) then return end

    local orig = gh.getAim
    gh.getAim = function(...)
        local a = table.pack(...)
        if (SA.on or SA.forcePart) and (SA.locked or SA.forcePart) then
            local targetPart = SA.forcePart or SA.locked
            local bypassFov = SA.forcePart ~= nil
            local sp, vis = Camera2:WorldToViewportPoint(targetPart.Position)
            local rad = math.tan(math.rad(math.min(SA.fov/2, 89))) / math.tan(math.rad(Camera2.FieldOfView/2)) * (Camera2.ViewportSize.Y/2)
            local inFov = bypassFov or (vis and sp.Z > 0 and (Vector2.new(sp.X, sp.Y) - getAimPoint()).Magnitude <= rad)
            if inFov and saVisible(targetPart) then
                local origin
                for _, v in ipairs(a) do if typeof(v) == "Vector3" then origin = v break end end
                if origin then
                    local dir = targetPart.Position - origin
                    if dir.Magnitude > 0 then return dir.Unit, dir.Magnitude end
                end
            end
        end
        return orig(table.unpack(a, 1, a.n))
    end
end)

-- ============================================================
-- METATABLE HOOK
-- ============================================================
local exec = identifyexecutor()
if exec == "Solara" or exec == "Xeno" then
    warn("Metatable hook skipped: " .. exec .. " detected")
else
    pcall(function()
        local mt = getrawmetatable(game)
        local idx = mt.__index
        setreadonly(mt, false)

        local wrap = (type(newcclosure) == "function") and newcclosure or function(f) return f end

        local hooked = wrap(function(self, key)
            -- FAST EXIT: only inspect Mouse.Hit / Mouse.HitCFrame
            if self ~= Mouse then
                return idx(self, key)
            end
            if key ~= "Hit" and key ~= "HitCFrame" then
                return idx(self, key)
            end
            if not (SA.on or SA.forcePart) then
                return idx(self, key)
            end

            local targetPart = SA.forcePart or SA.locked
            if not targetPart or not targetPart.Parent then
                return idx(self, key)
            end

            local ok = pcall(function()
                local sp, vis = Camera2:WorldToViewportPoint(targetPart.Position)
                local bypassFov = SA.forcePart ~= nil
                local rad = math.tan(math.rad(math.min(SA.fov / 2, 89)))
                            / math.tan(math.rad(Camera2.FieldOfView / 2))
                            * (Camera2.ViewportSize.Y / 2)
                local inFov = bypassFov or (vis and sp.Z > 0
                    and (Vector2.new(sp.X, sp.Y) - getAimPoint()).Magnitude <= rad)
                if inFov and saVisible(targetPart) then
                    SA._hitOverride = CFrame.new(targetPart.Position)
                else
                    SA._hitOverride = nil
                end
            end)

            if ok and SA._hitOverride then
                local ret = SA._hitOverride
                SA._hitOverride = nil
                return ret
            end
            SA._hitOverride = nil
            return idx(self, key)
        end)

        mt.__index = hooked
        setreadonly(mt, true)
    end)
end

