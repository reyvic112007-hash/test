local function autoAmmoRunPass(force)
    if T.AutoAmmoBusy or not T.AutoAmmoEnabled then return end
    if not force and (tick() - T._lastAutoAmmo < 1.5) then return end
    if not autoAmmoNeedsBuy() then return end

    T.AutoAmmoBusy    = true
    T._lastAutoAmmo   = tick()
    T.buyingGunsState = true
    _G.MyActiveAction = "Auto Ammo: Buying"

    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if root then
        root.AssemblyLinearVelocity  = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end

    task.spawn(function()
        for _, e in ipairs(AUTO_AMMO_LIST) do
            if not T.AutoAmmoEnabled then break end
            if not GAK_atCap(e.name) then
                local item = findShopItem(e.kw)
                if item then
                    buyAmmoClicks(item, 10, e.name, function() return T.AutoAmmoEnabled end)
                end
            end
            task.wait(0.2)
        end
        T.buyingGunsState = false
        _G.MyActiveAction = T.GunAutoKillEnabled and "Gun Core Loop" or "Idle"
        T.AutoAmmoBusy    = false
    end)
end
