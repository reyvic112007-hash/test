-- ============================================================
-- RESERVE AMMO CAPS (per gun)
-- Reserve lives in DataFolder.Inventory[gunName]
-- Buy stops once reserve >= this value.
-- ============================================================
local GAK_RESERVE_CAP = {
    ["[Rifle]"]    = 30,
    ["[AUG]"]      = 500,
    ["[Revolver]"] = 60,
    ["[LMG]"]      = 1000,
}

local function GAK_getReserve(gunName)
    local df  = LocalPlayer:FindFirstChild("DataFolder")
    local inv = df and df:FindFirstChild("Inventory")
    local val = inv and inv:FindFirstChild(gunName)
    if val then return tonumber(val.Value) or 0 end
    return 0
end

local function GAK_atCap(gunName)
    local cap = GAK_RESERVE_CAP[gunName]
    if not cap then return true end
    return GAK_getReserve(gunName) >= cap
end

-- ============================================================
-- SHARED AMMO BUY HELPER (used by both toggles)
-- Buys up to `times` clicks for `item`, aborts at cap or when
-- the given enabled-check returns false.
-- ============================================================
local function buyAmmoClicks(item, times, capGun, isEnabled)
    if not item then return end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local detector = item:FindFirstChildWhichIsA("ClickDetector", true)
    if not detector then return end
    if capGun and GAK_atCap(capGun) then return end

    local oldCF = root.CFrame
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then tool.Parent = LocalPlayer.Backpack end

    root.CFrame = item:GetPivot() + Vector3.new(0, 3, 0)
    task.wait(0.2)

    for _ = 1, (times or 1) do
        if isEnabled and not isEnabled() then break end
        if capGun and GAK_atCap(capGun) then break end
        fireclickdetector(detector)
        task.wait(0.15)
    end

    if tool then tool.Parent = LocalPlayer.Character end
    root.CFrame = oldCF
end

