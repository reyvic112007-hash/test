local function Align(P0, P1, P, R)
    local A0 = Instance.new('Attachment', P0)
    local A1 = Instance.new('Attachment', P1)
    local AP = Instance.new('AlignPosition', P0)
    local AO = Instance.new('AlignOrientation', P0)
    A1.Position = P
    A0.Rotation = R
    AP.RigidityEnabled = true
    AP.Responsiveness = 200
    AP.Attachment0 = A0
    AP.Attachment1 = A1
    AO.MaxTorque = 9e9
    AO.Responsiveness = 200
    AO.RigidityEnabled = true
    AO.Attachment0 = A0
    AO.Attachment1 = A1
    return A0, A1, AP, AO
end
Main:addButton("Troll Grenade", function()
    if _G.TrollGrenadeCleanup then
        pcall(_G.TrollGrenadeCleanup)
        _G.TrollGrenadeCleanup = nil
    end

    local CONFIG = {
        Height        = 3,
        Speed         = 4,
        SteerResponse = 14,
        SteerMin      = 50,
        SteerMax      = 350,
        GrenadeName   = "[Grenade]",
    }

    local State = {
        Connections = {}, Grenades = {}, Target = nil,
        Active = false, Formation = nil, ActiveToken = nil, StartedAt = 0,
    }

    local function Connect(sig, fn)
        local c = sig:Connect(fn); table.insert(State.Connections, c); return c
    end
    local function DisconnectAll()
        for _, c in ipairs(State.Connections) do pcall(function() c:Disconnect() end) end
        table.clear(State.Connections)
    end
    local function GetRoot()
        local c = LocalPlayer.Character; return c and c:FindFirstChild("HumanoidRootPart")
    end
    local function Steer(obj, targetPos)
        local dir = targetPos - obj.Position
        local d = dir.Magnitude
        if d > 0.01 then
            obj.AssemblyLinearVelocity =
                dir.Unit * math.clamp(d * CONFIG.SteerResponse, CONFIG.SteerMin, CONFIG.SteerMax)
        end
    end

    local F = {}

    F.Tornado = { Desc = "Rising vortex funnel",
        Pos = function(root, t, i, total)
            local layer = (i - 1) / math.max(1, total - 1)
            local a = layer * math.pi * 4 + t * (2 + layer * 4)
            local r = 2 + layer * 9
            local y = layer * 14 - 4
            return (root.CFrame * CFrame.new(math.cos(a) * r, y + CONFIG.Height, math.sin(a) * r)).Position
        end,
    }

    F.Galaxy = { Desc = "Two-arm spiral galaxy",
        Pos = function(root, t, i, total)
            local arm = (i % 2 == 0) and 0 or math.pi
            local prog = (i - 1) / math.max(1, total - 1)
            local r = prog * 11
            local a = prog * math.pi * 3 + t * 1.5 + arm
            local y = math.sin(prog * 3) * 2
            return (root.CFrame * CFrame.new(math.cos(a) * r, y + CONFIG.Height, math.sin(a) * r)).Position
        end,
    }

    F.Heart = { Desc = "Heart shape",
        Pos = function(root, t, i, total)
            local s = (i / total) * math.pi * 2
            local sc = 0.55
            local x = 16 * math.sin(s)^3
            local y = 13 * math.cos(s) - 5 * math.cos(2*s) - 2 * math.cos(3*s) - math.cos(4*s)
            return (root.CFrame * CFrame.new(x * sc, y * sc + 6, 0)).Position
        end,
    }

    F.DNA = { Desc = "Double helix strand",
        Pos = function(root, t, i, total)
            local strand = (i % 2 == 0) and 0 or math.pi
            local prog = (i - 1) / math.max(1, total - 1)
            local a = prog * math.pi * 4 + t * 2 + strand
            local y = (prog - 0.5) * 16
            return (root.CFrame * CFrame.new(math.cos(a) * 6, y + CONFIG.Height, math.sin(a) * 6)).Position
        end,
    }

    F.Spiral = { Desc = "Vertical corkscrew",
        Pos = function(root, t, i, total)
            local prog = (i - 1) / math.max(1, total - 1)
            local a = prog * math.pi * 6 + t * 2
            local y = (prog - 0.5) * 14
            return (root.CFrame * CFrame.new(math.cos(a) * 8, y + CONFIG.Height, math.sin(a) * 8)).Position
        end,
    }

    F.Saturn = { Desc = "Tilted ring with core",
        Pos = function(root, t, i, total)
            local ringCount = math.floor(total * 0.7)
            if i <= ringCount then
                local a = ((i - 1) / ringCount) * math.pi * 2 + t
                local x = math.cos(a) * 11
                local z = math.sin(a) * 11
                local tilt = math.rad(30)
                local y = z * math.sin(tilt)
                local z2 = z * math.cos(tilt)
                return (root.CFrame * CFrame.new(x, y + CONFIG.Height, z2)).Position
            else
                local j = i - ringCount
                local n = math.max(1, total - ringCount)
                local phi   = math.acos(1 - 2 * (j - 0.5) / n)
                local theta = math.pi * (1 + 5^0.5) * j + t
                local r = 3
                local dir = Vector3.new(
                    math.cos(theta) * math.sin(phi),
                    math.cos(phi),
                    math.sin(theta) * math.sin(phi))
                return (root.CFrame * CFrame.new(dir.X * r, dir.Y * r + CONFIG.Height, dir.Z * r)).Position
            end
        end,
    }

    F.Star = { Desc = "Five-point star",
        Pos = function(root, t, i, total)
            local a = (i / total) * math.pi * 2 + t * 0.5
            local r = 3 + 8 * math.abs(math.sin(2.5 * a))
            return (root.CFrame * CFrame.new(math.cos(a) * r, math.sin(a) * r + 6, 0)).Position
        end,
    }

    F.Lissajous = { Desc = "3D figure-8 curve",
        Pos = function(root, t, i, total)
            local s = (i / total) * math.pi * 2 + t
            local x = math.sin(s * 2) * 8
            local y = math.sin(s * 3) * 4
            local z = math.cos(s) * 5
            return (root.CFrame * CFrame.new(x, y + CONFIG.Height, z)).Position
        end,
    }

    F.Infinity = { Desc = "Infinity symbol",
        Pos = function(root, t, i, total)
            local s = (i / total) * math.pi * 2 + t
            local scale = 9
            local x = math.cos(s) / (1 + math.sin(s)^2)
            local z = math.sin(s) * math.cos(s) / (1 + math.sin(s)^2)
            return (root.CFrame * CFrame.new(x * scale, CONFIG.Height, z * scale)).Position
        end,
    }

    F.Sphere = { Desc = "Fibonacci sphere bubble",
        Pos = function(root, t, i, total)
            local phi   = math.acos(1 - 2 * (i - 0.5) / total)
            local theta = math.pi * (1 + 5^0.5) * i + t
            local r = 8
            local dir = Vector3.new(
                math.cos(theta) * math.sin(phi),
                math.cos(phi),
                math.sin(theta) * math.sin(phi))
            return (root.CFrame * CFrame.new(dir.X * r, dir.Y * r + CONFIG.Height, dir.Z * r)).Position
        end,
    }

    F.Triangle = { Desc = "Triangle outline",
        Pos = function(root, t, i, total)
            local A = Vector2.new(-5, -3)
            local B = Vector2.new( 5, -3)
            local C = Vector2.new( 0,  6)
            local L1 = (B - A).Magnitude
            local L2 = (C - B).Magnitude
            local L3 = (A - C).Magnitude
            local P  = L1 + L2 + L3
            local s = ((i - 1) / math.max(1, total)) * P
            local pt
            if s < L1 then
                pt = A:Lerp(B, s / L1)
            elseif s < L1 + L2 then
                pt = B:Lerp(C, (s - L1) / L2)
            else
                pt = C:Lerp(A, (s - L1 - L2) / L3)
            end
            return (root.CFrame * CFrame.new(pt.X, pt.Y + 5, 0)).Position
        end,
    }

    F.Spread = {
        Desc = "Box grid beneath you, then drop",
        ReleaseAfter = 1.5,
        Pos = function(root, t, i, total)
            local gs = math.max(2, math.ceil(math.sqrt(total)))
            local spacing = 5
            local offset = (gs - 1) / 2
            local perimeter = {}
            for r = 0, gs - 1 do
                for c = 0, gs - 1 do
                    if r == 0 or r == gs - 1 or c == 0 or c == gs - 1 then
                        table.insert(perimeter, {r, c})
                    end
                end
            end
            local slot = perimeter[((i - 1) % #perimeter) + 1]
            local x = (slot[2] - offset) * spacing
            local z = (slot[1] - offset) * spacing
            return (root.CFrame * CFrame.new(x, -3, z)).Position
        end,
    }

    local function StartLoop()
        Connect(RunService.Heartbeat, function()
            if not State.Active or not State.Formation then return end
            local Root = GetRoot(); if not Root then return end
            if State.Target then
                State.Target.Position = (Root.CFrame * CFrame.new(0, CONFIG.Height, 0)).Position
            end

            local total = #State.Grenades; if total == 0 then return end
            local t = os.clock() * CONFIG.Speed
            local elapsed = os.clock() - State.StartedAt
            local released = State.Formation.ReleaseAfter and elapsed > State.Formation.ReleaseAfter

            for i = total, 1, -1 do
                local obj = State.Grenades[i]
                if obj and obj.Parent then
                    if not released then
                        pcall(function()
                            Steer(obj, State.Formation.Pos(Root, t, i, total))
                        end)
                    end
                else
                    table.remove(State.Grenades, i)
                end
            end
        end)
    end

    local function StartTracking()
        local Ignored = workspace:FindFirstChild("Ignored")
        if not Ignored then warn("[Troll Grenade] workspace.Ignored not found"); return false end
        Connect(Ignored.ChildAdded, function(object)
            if not State.Active then return end
            if not (object:IsA("BasePart") and object.Name == "Handle") then return end
            task.spawn(function()
                task.wait()
                if not State.Active or not object.Parent then return end
                if table.find(State.Grenades, object) then return end
                table.insert(State.Grenades, object)
                object.Destroying:Connect(function()
                    local idx = table.find(State.Grenades, object)
                    if idx then table.remove(State.Grenades, idx) end
                end)
            end)
        end)
        return true
    end

    local function ThrowAll()
        table.clear(State.Grenades)
        local Backpack  = LocalPlayer:FindFirstChild("Backpack")
        local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        if not Backpack or not Character then return end

        local Equipped = {}
        for _, t in ipairs(Backpack:GetChildren()) do
            if t:IsA("Tool") and t.Name == CONFIG.GrenadeName then
                t.Parent = Character; Equipped[#Equipped+1] = t
            end
        end
        if #Equipped == 0 then warn("[Troll Grenade] No " .. CONFIG.GrenadeName .. " tools found"); return end

        task.wait(0.2)
        for _, g in ipairs(Equipped) do if g.Parent then pcall(function() g:Activate() end) end end
        task.wait(0.4)
        for _, g in ipairs(Equipped) do if g.Parent then pcall(function() g:Activate() end) end end

        print(("[Troll Grenade] Threw %d grenades"):format(#Equipped))
    end

    local function Cleanup()
        State.Active = false; State.Formation = nil; State.ActiveToken = nil
        DisconnectAll(); table.clear(State.Grenades)
        if State.Target then pcall(function() State.Target:Destroy() end); State.Target = nil end
    end

    local function Start(formation)
        if State.Active then return end
        State.Active = true
        State.Formation = formation
        State.StartedAt = os.clock()
        table.clear(State.Grenades)

        State.Target = Instance.new("Part")
        State.Target.Name = "GrenadeFormationTarget"
        State.Target.Size = Vector3.new(1,1,1)
        State.Target.Transparency = 1
        State.Target.Anchored = true
        State.Target.CanCollide = false
        State.Target.CanTouch = false
        State.Target.CanQuery = false
        State.Target.Parent = workspace

        if not StartTracking() then Cleanup(); return end
        StartLoop()
    end

    local function RemoveToolNamed(name)
        for _, c in ipairs({LocalPlayer:FindFirstChild("Backpack"), LocalPlayer.Character}) do
            if c then
                for _, item in ipairs(c:GetChildren()) do
                    if item:IsA("Tool") and item.Name == name then item:Destroy() end
                end
            end
        end
    end

    local function CreateTool(name, formation)
        RemoveToolNamed(name)

        local tool = Instance.new("Tool")
        tool.Name = name
        tool.RequiresHandle = true
        tool.CanBeDropped = false
        tool.ToolTip = formation.Desc or name

        local handle = Instance.new("Part")
        handle.Name = "Handle"; handle.Size = Vector3.new(0.5,0.5,0.5)
        handle.Transparency = 1; handle.CanCollide = false; handle.Massless = true
        handle.Parent = tool

        tool.Parent = LocalPlayer:WaitForChild("Backpack")

        local token = {}
        tool.Activated:Connect(function()
            Cleanup()
            State.ActiveToken = token
            Start(formation)
            ThrowAll()
        end)
        tool.Unequipped:Connect(function()
            if State.ActiveToken == token then Cleanup() end
        end)
        return tool
    end

    local AllTools = {}

    local function CreateAll()
        for _, t in ipairs(AllTools) do if t and t.Parent then t:Destroy() end end
        table.clear(AllTools)
        for key, formation in pairs(F) do
            table.insert(AllTools, CreateTool("Grenade " .. key, formation))
        end
        print(("[Troll Grenade] %d tools added to backpack."):format(#AllTools))
    end

    CreateAll()

    if not _G.TrollGrenadeRespawnConn then
        _G.TrollGrenadeRespawnConn = LocalPlayer.CharacterAdded:Connect(function()
            task.wait(1)
            if _G.TrollGrenadeCreateAll then
                pcall(_G.TrollGrenadeCreateAll)
            end
        end)
    end

    _G.TrollGrenadeCreateAll = CreateAll

    _G.TrollGrenadeCleanup = function()
        Cleanup()
        for _, t in ipairs(AllTools) do
            pcall(function() t:Destroy() end)
        end
    end
end)
