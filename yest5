Misc:AddToggle("GodBlock", {
    Text = "God Block", Default = false,
    Callback = function(t)
        getgenv().XZQW_GodBlock = t

        if t == true then
            if getgenv().AUTO_BLOCK__ then
            else
                game.ReplicatedStorage.MainEvent:FireServer("ResetNew")
                game.Players.LocalPlayer.Character.Humanoid:ChangeState'Dead'
            end

            game:GetService("ReplicatedStorage").ClientAnimations.Block.AnimationId = "rbxassetid://0"

            -- ===== Patch getCanShoot so firing works while blocked =====
            if not getgenv()._gb_canShootOrig then
                local ok, err = pcall(function()
                    local GH = require(game.ReplicatedStorage.Modules.GunHandler)
                    if type(GH) ~= "table" or type(GH.getCanShoot) ~= "function" then
                        error("GunHandler.getCanShoot is not a function")
                    end
                    getgenv()._gb_canShootOrig = GH.getCanShoot
                    GH.getCanShoot = function(char)
                        if getgenv().XZQW_GodBlock then return true end
                        return getgenv()._gb_canShootOrig(char)
                    end
                end)
                if ok then
                    print("[GodBlock] ✓ getCanShoot patched — shooting while blocked enabled")
                else
                    warn("[GodBlock] ⚠ Your executor does not support patching getCanShoot (or the module is missing).")
                    warn("[GodBlock]   Reason: "..tostring(err))
                    warn("[GodBlock]   → Continuing — GodBlock will work, but you will NOT be able to shoot while blocked.")
                end
            end

            -- ===== NoSlow: install WalkSpeed clamp (once) =====
            if not getgenv()._gb_wsHooked then
                local ok, err = pcall(function()
                    if type(getrawmetatable) ~= "function" then
                        error("getrawmetatable is missing")
                    end
                    if type(setreadonly) ~= "function" then
                        error("setreadonly is missing")
                    end
                    if type(newcclosure) ~= "function" then
                        error("newcclosure is missing")
                    end
                    local mt = getrawmetatable(game)
                    local oldNewIndex = mt.__newindex
                    setreadonly(mt, false)
                    mt.__newindex = newcclosure(function(self, key, value)
                        if key == "WalkSpeed"
                           and typeof(value) == "number"
                           and getgenv().XZQW_GodBlock
                           and value < 16 then
                            return oldNewIndex(self, key, 16)
                        end
                        return oldNewIndex(self, key, value)
                    end)
                    setreadonly(mt, true)
                end)
                if ok then
                    getgenv()._gb_wsHooked = true
                    print("[GodBlock] ✓ WalkSpeed clamp installed — no slowdown (smooth)")
                else
                    warn("[GodBlock] ⚠ Your executor does not support metatable hooks.")
                    warn("[GodBlock]   Reason: "..tostring(err))
                    warn("[GodBlock]   → Continuing — NoSlow will still work via Stepped fallback (may have tiny 1-frame dips).")
                end
            end

            local OWNER = game:GetService("Players").LocalPlayer
            local GUN_CHECK = nil
            task.wait()

            function Block()
                game.ReplicatedStorage.MainEvent:FireServer("Block", true)
                wait()
                game.ReplicatedStorage.MainEvent:FireServer("Block", false)
            end

            if getgenv().AUTO_BLOCK__ then getgenv().AUTO_BLOCK__:Disconnect() end
            getgenv().AUTO_BLOCK__ = game:GetService("RunService").Stepped:Connect(function()
                if blocking == true then
                    local char = OWNER.Character
                    if not char then return end
                    local be = char:FindFirstChild('BodyEffects')
                    if be and be:FindFirstChild('Block') then be.Block:Destroy() end

                    -- NoSlow fallback (works on every executor)
                    local hum = char:FindFirstChildOfClass('Humanoid')
                    if hum and hum.WalkSpeed < 16 then hum.WalkSpeed = 16 end

                    GUN_CHECK = char:FindFirstChildWhichIsA("Tool")
                    if GUN_CHECK then
                        if GUN_CHECK:FindFirstChild("GunScript") then
                            game.ReplicatedStorage.MainEvent:FireServer("Block", true)
                        else
                            Block()
                        end
                    else
                        Block()
                    end
                end
            end)

            blocking = true
            task.wait()

        elseif t == false then
            blocking = false
            getgenv().XZQW_GodBlock = false
        end
    end
})
getgenv().YRWL_NoSlowConn___ = getgenv().YRWL_NoSlowConn___ or {}

Misc:AddToggle("NoSlow", {
    Text = "No Slow", Default = false,
    Callback = function(state)
        getgenv().XZQW_NoSlow = state

        if state then
            Notify("No Slow Enabled", 2)

            local MIN_WALKSPEED = 16

            -- Try to install __newindex hook (executor-only).
            -- If any function is missing, skip silently and rely on the
            -- Stepped fallback below.
            if not getgenv()._ns_wsHooked then
                local ok, err = pcall(function()
                    local mt = getrawmetatable(game)
                    local oldNewIndex = mt.__newindex
                    setreadonly(mt, false)
                    mt.__newindex = newcclosure(function(self, key, value)
                        if key == "WalkSpeed"
                           and typeof(value) == "number"
                           and getgenv().XZQW_NoSlow
                           and value < MIN_WALKSPEED then
                            return oldNewIndex(self, key, MIN_WALKSPEED)
                        end
                        return oldNewIndex(self, key, value)
                    end)
                    setreadonly(mt, true)
                end)
                if ok then
                    getgenv()._ns_wsHooked = true
                    print("[NoSlow] WalkSpeed clamp installed (min "..MIN_WALKSPEED..")")
                else
                    warn("[NoSlow] __newindex hook unavailable, using Stepped fallback only: "..tostring(err))
                end
            end

            -- Fallback: poll WalkSpeed every frame.
            -- Works on any executor (no metatable needed), just less snappy
            -- than the __newindex hook — you may feel a 1-frame dip.
            table.insert(getgenv().YRWL_NoSlowConn___, RunService.Stepped:Connect(function()
                if not getgenv().XZQW_NoSlow then return end
                local c = LocalPlayer.Character
                if not c then return end
                local hum = c:FindFirstChildOfClass('Humanoid')
                if not hum then return end
                if hum.WalkSpeed < MIN_WALKSPEED then
                    hum.WalkSpeed = MIN_WALKSPEED
                end
            end))

        else
            Notify("No Slow Disabled", 1.5)
            for _, conn in ipairs(getgenv().YRWL_NoSlowConn___) do
                if conn then conn:Disconnect() end
            end
            table.clear(getgenv().YRWL_NoSlowConn___)
        end
    end
})
