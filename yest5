CamlockHitParts = { "Head" }
CurrentCycleIndex = 1
LastCycleTime = 0
CycleSpeed = 0.15
UseDynamicPrediction = false
CustomPredictionValue = 0.12588
CustomPredictionY = 0.12588
PredictionOffsetY = 0
UnlockWhenKO = false
CurrentTarget = nil
TargetBodyPart = nil
CamlockConnection = nil
PositionHistory = {}
DerivedVelocity = Vector3.zero

function GetCamlockPrediction(target)
    if not UseDynamicPrediction then return CustomPredictionValue end
    local raw = GetPing()
    local ds = "General"
    if target and target.Character and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and target.Character:FindFirstChild("HumanoidRootPart") then
        local d = (LocalPlayer.Character.HumanoidRootPart.Position - target.Character.HumanoidRootPart.Position).Magnitude
        if d < 30 then ds = "Close" elseif d < 85 then ds = "Mid" else ds = "Far" end
    end
    local p = { General = {0.12588}, Far = {0.1305}, Mid = {0.1285}, Close = {0.1265} }
    return p[ds][math.random(1, #p[ds])]
end

function GetClosestHitbox(player)
    if not player or not player.Character or #CamlockHitParts == 0 then return nil end
    if os.clock() - LastCycleTime >= CycleSpeed then
        LastCycleTime = os.clock()
        CurrentCycleIndex = (CurrentCycleIndex % #CamlockHitParts) + 1
    end
    for i = 0, #CamlockHitParts - 1 do
        local idx = ((CurrentCycleIndex - 1 + i) % #CamlockHitParts) + 1
        local found = player.Character:FindFirstChild(CamlockHitParts[idx])
        if found then return found end
    end
    return player.Character:FindFirstChild("HumanoidRootPart") or player.Character:FindFirstChild("Head")
end

function GetClosestPlayerToMouse()
    local maxD = (getgenv().FOV_ENABLED and getgenv().FOV_SIZE) or math.huge
    local t = nil
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local sp, vis = Camera2:WorldToViewportPoint(root.Position)
                local d = (UserInputService:GetMouseLocation() - Vector2.new(sp.X, sp.Y)).Magnitude
                if d < maxD and vis then maxD = d t = p end
            end
        end
    end
    return t
end

RunService.Heartbeat:Connect(function()
    if CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("HumanoidRootPart") then
        local root = CurrentTarget.Character.HumanoidRootPart
        local last = PositionHistory[CurrentTarget]
        if last then
            local dt = tick() - last.Time
            if dt > 0 then DerivedVelocity = (root.Position - last.Position) / dt end
        end
        PositionHistory[CurrentTarget] = { Position = root.Position, Time = tick() }
    else
        DerivedVelocity = Vector3.zero
    end
end)

function StartCamlockEngine()
    if CamlockConnection then return end
    CamlockConnection = RunService.Heartbeat:Connect(function()
        if not getgenv().Camlock then return end
        local active = CurrentTarget
        if not active or not active.Character or not active.Character:FindFirstChild("HumanoidRootPart") or (UnlockWhenKO and IsTargetKO(active)) then
            if not getgenv().StickyAim then CurrentTarget = nil end
            TargetBodyPart = nil
            return
        end
        TargetBodyPart = GetClosestHitbox(active)
        if not TargetBodyPart then return end
        local pos = TargetBodyPart.Position
        local vel = (getgenv().Resolver and DerivedVelocity ~= Vector3.zero) and DerivedVelocity or active.Character.HumanoidRootPart.AssemblyLinearVelocity
        local px = UseDynamicPrediction and GetCamlockPrediction(active) or CustomPredictionValue
        local py = UseDynamicPrediction and GetCamlockPrediction(active) or CustomPredictionY
        local pz = UseDynamicPrediction and GetCamlockPrediction(active) or CustomPredictionValue
        local calc = Vector3.new(vel.X*px, (vel.Y*py)+PredictionOffsetY, vel.Z*pz)
        Camera2.CFrame = CFrame.new(Camera2.CFrame.Position, pos + calc)
    end)
end

function StopCamlockEngine()
    if CamlockConnection then CamlockConnection:Disconnect() CamlockConnection = nil end
end

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if getgenv().StickyAim and input.KeyCode == Enum.KeyCode.V then
        if CurrentTarget then
            CurrentTarget = nil
        else
            local t = GetClosestPlayerToMouse()
            if t then CurrentTarget = t end
        end
    end
end)

