function IsTargetKO(player)
    if not player or not player.Character then return true end
    local c = player.Character
    local be = c:FindFirstChild("BodyEffects")
    local ko = be and (be:FindFirstChild("KO") or be:FindFirstChild("K.O") or be:FindFirstChild("KnockedOut"))
    local dead = be and (be:FindFirstChild("Dead") or be:FindFirstChild("Death"))
    local hum = c:FindFirstChildOfClass("Humanoid")
    return (ko and ko.Value) or (dead and dead.Value) or (hum and hum.Health <= 0) or false
end

