local function runMaskLoop(myId)
    task.spawn(function()
        while maskEnabled and maskLoopId == myId do
            task.wait(0.25)
            local char = game.Players.LocalPlayer.Character
            local humanoid = char and char:FindFirstChild("Humanoid")
            if not char or not humanoid or humanoid.Health <= 0 then
                -- skip iteration (was: continue)
            else
                local bp = game.Players.LocalPlayer:FindFirstChild("Backpack")
                local hasMask = (bp and bp:FindFirstChild("[Mask]")) or char:FindFirstChild("[Mask]")
                if not hasMask then
                    local shopItem = findShopItem(maskShopMap[maskSelected])
                    local root = char:FindFirstChild("HumanoidRootPart")
                    local cd = shopItem and shopItem:FindFirstChildOfClass("ClickDetector")
                    if not shopItem or not shopItem:FindFirstChild("Head") or not root or not cd then
                        -- skip iteration (was: continue)
                    else
                        maskTpPos = shopItem.Head.Position - Vector3.new(0, 2, 0)
                        maskCsync = true
                        task.wait(0.15)
                        local start = tick()
                        while not ((game.Players.LocalPlayer.Backpack:FindFirstChild("[Mask]")) or char:FindFirstChild("[Mask]")) and tick() - start < 8 do
                            pcall(function() fireclickdetector(cd) end)
                            task.wait(0.04)
                        end
                        maskCsync = false
                        maskTpPos = nil
                        maskOldCF = nil
                        resetcam()
                        Notify("Mask acquired: " .. maskSelected, 2)
                        task.wait(0.3)
                        -- was: continue — nothing else to do this iteration
                    end
                else
                    local maskTool = char:FindFirstChild("[Mask]") or (bp and bp:FindFirstChild("[Mask]"))
                    if not maskTool then
                        -- skip iteration (was: continue)
                    else
                        local shouldReturn = false
                        if bp and bp:FindFirstChild("[Mask]") then
                            pcall(function() humanoid:EquipTool(maskTool) end)
                            task.wait(0.3)
                            maskTool = char:FindFirstChild("[Mask]")
                            if not maskTool then
                                shouldReturn = true -- was: continue
                            end
                        end
                        if not shouldReturn then
                            if char:FindFirstChild("[Mask]") then
                                pcall(function() maskTool:Activate() end)
                                task.wait(0.3)
                                pcall(function() humanoid:UnequipTools() end)
                                Notify("Mask activated & unequipped", 1.5)
                                maskLoopId = maskLoopId + 1
                                return
                            end
                        end
                    end
                end
            end
        end
    end)
end
