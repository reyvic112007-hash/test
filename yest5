            autoSaveState.loop = nil
        end

        -- Always clean up csync when toggling off
        if not state then
            autoSaveState.csync = false
            autoSaveState.tpPos = nil
            autoSaveState.oldCF = nil
            Notify("Auto Save Disabled", 1.5)
            return
        end


        Notify("Auto Save Enabled — waiting for KO...", 2)

        autoSaveState.loop = RunService.Heartbeat:Connect(function()
            if not autoSaveState.enabled then
                autoSaveState.csync = false
                autoSaveState.tpPos = nil
                autoSaveState.oldCF = nil
                if autoSaveState.loop then
                    autoSaveState.loop:Disconnect()
                    autoSaveState.loop = nil
                end
                return
            end

            local target = findMatchingPlayer(autoSaveState.victimInput)
            local char   = LocalPlayer.Character
            local root   = char and char:FindFirstChild("HumanoidRootPart")
            local hum    = char and char:FindFirstChildOfClass("Humanoid")

            if not target or not root or not hum then
                autoSaveState.csync = false
                autoSaveState.tpPos = nil
                return
            end

            local tChar  = target.Character
            local tRoot  = tChar and tChar:FindFirstChild("HumanoidRootPart")
            local tUpper = tChar and tChar:FindFirstChild("UpperTorso")
            local tHum   = tChar and tChar:FindFirstChildOfClass("Humanoid")
            local be     = tChar and tChar:FindFirstChild("BodyEffects")

            if not tRoot or not tHum then
                autoSaveState.csync = false
                autoSaveState.tpPos = nil
                return
            end

            local isKO   = be and (
                (be:FindFirstChild("K.O") and be["K.O"].Value == true) or
                (be:FindFirstChild("KO")  and be.KO.Value == true)
            )
            local isDead = be and be:FindFirstChild("SDeath") and be["SDeath"].Value == true

            -- Target died — stop everything
            if isDead or tHum.Health <= 0 then
                autoSaveState.enabled = false
                autoSaveState.csync   = false
                autoSaveState.tpPos   = nil
                autoSaveState.oldCF   = nil
                if autoSaveState.loop then
                    autoSaveState.loop:Disconnect()
                    autoSaveState.loop = nil
                end
                Notify("Auto Save: Target is dead, stopping.", 2)
                return
            end

            -- Already grabbed — stop csync first, then go home
            if tChar:FindFirstChild("GRABBING_CONSTRAINT") or char:FindFirstChild("GRABBING_CONSTRAINT") then
                autoSaveState.enabled = false
                autoSaveState.csync   = false
                autoSaveState.tpPos   = nil
                autoSaveState.oldCF   = nil
                if autoSaveState.loop then
                    autoSaveState.loop:Disconnect()
                    autoSaveState.loop = nil
                end

                
                return
            end

            -- Not KO'd yet — clear csync and wait
            if not isKO then
                autoSaveState.csync = false
                autoSaveState.tpPos = nil
                return
            end

            -- KO confirmed — use fake dummy to position near target
            local grabPart = tUpper or tRoot
            autoSaveState.tpPos = grabPart.Position + Vector3.new(0, 2, 0)
            autoSaveState.csync = true

            local activeTool = char:FindFirstChildOfClass("Tool")
            if activeTool then activeTool.Parent = LocalPlayer.Backpack end

            if tick() - autoSaveState.lastGrab >= 0.3 then
                autoSaveState.lastGrab = tick()
