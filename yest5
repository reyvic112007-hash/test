function applyFullBright()
    Lighting.FogStart = 100000 Lighting.FogEnd = 100000 Lighting.FogColor = Color3.new(0,0,0)
    Lighting.TimeOfDay = "14:00:00"
    Lighting.Ambient = LState.AmbientEnabled and LState.AmbientColor or Color3.new(1,1,1)
    Lighting.OutdoorAmbient = LState.OutdoorAmbientEnabled and LState.OutdoorAmbientColor or Color3.new(1,1,1)
    Lighting.Brightness = 2
end
function restoreDefault()
    Lighting.FogStart = LState.FogEnabled and 100 or OriginalLighting.FogStart
    Lighting.FogEnd = LState.FogEnabled and 500 or OriginalLighting.FogEnd
    Lighting.FogColor = OriginalLighting.FogColor
    Lighting.TimeOfDay = OriginalLighting.TimeOfDay
    Lighting.Ambient = LState.AmbientEnabled and LState.AmbientColor or OriginalLighting.Ambient
    Lighting.OutdoorAmbient = LState.OutdoorAmbientEnabled and LState.OutdoorAmbientColor or OriginalLighting.OutdoorAmbient
    Lighting.Brightness = OriginalLighting.Brightness
end
function refreshLighting() if LState.FullBright then applyFullBright() else restoreDefault() end end
function applySkybox()
    local sd = LState.SelectedSkybox and Skyboxes[LState.SelectedSkybox]
    if not sd then Notify("Select a valid skybox first.", 3) return end
    for _, c in ipairs(Lighting:GetChildren()) do
        if c:IsA("Sky") and c.Name == "CustomSky" then c:Destroy() end
    end
    local s = Instance.new("Sky")
    s.Name = "CustomSky"
    for prop, id in pairs(sd) do s[prop] = id end
    s.Parent = Lighting
    Notify("Applied skybox: "..LState.SelectedSkybox, 3)
end
function getSkyboxNames()
    local names = {}
    for n in pairs(Skyboxes) do table.insert(names, n) end
    table.sort(names)
    return names
end

