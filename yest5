local FLAME_HOLDER_OFFSET = 10
local FLAME_STOMP_OFFSET = 3
local flameVersion = 0
local flameAttached = false
local flameTarget = nil
local flamePendingTarget = nil
local flamePendingSkipBuy = false
local flameStartAttack

local function isPlayerGone(player)
	return not player or not player.Parent
end

local function isTargetDead(char)
	if not char or not char.Parent then return true end
	local be = char:FindFirstChild("BodyEffects")
	if not be then return false end
	local dead = be:FindFirstChild("Dead") or be:FindFirstChild("Death")
	return dead and dead.Value
end

local function isTargetKO(char)
	if not char or not char.Parent then return false end
	local be = char:FindFirstChild("BodyEffects")
	if not be then return false end
	local ko = be:FindFirstChild("KO") or be:FindFirstChild("K.O")
	return ko and ko.Value
end

local function isTargetSDeath(char)
	if not char or not char.Parent then return false end
	local be = char:FindFirstChild("BodyEffects")
	if not be then return false end
	local sd = be:FindFirstChild("SDeath")
	return sd and sd.Value
end

local function isSelfDead()
	local lp = game.Players.LocalPlayer
	local char = lp.Character
	if not char then return true end
	local be = char:FindFirstChild("BodyEffects")
	if not be then return false end
	local dead = be:FindFirstChild("Dead") or be:FindFirstChild("Death")
	local ko = be:FindFirstChild("KO") or be:FindFirstChild("K.O")
	return (dead and dead.Value) or (ko and ko.Value)
end

local FLAME_GRIP_ACTIVE = CFrame.new(0.3879, 0, 0)
local FLAME_GRIP_DEFAULT = CFrame.new()

local function setFlameGrip(cf)
	local lp = game.Players.LocalPlayer
	local t = (lp.Character and lp.Character:FindFirstChild("[Flamethrower]"))
		or lp.Backpack:FindFirstChild("[Flamethrower]")
	if not t then return end
	local inChar = t.Parent == lp.Character
	if inChar then t.Parent = lp.Backpack end
	t.Grip = cf
	if inChar then
		t.Parent = lp.Character
		task.defer(function() if t and t.Parent then t.Grip = cf end end)
	end
end

local function savePendingAndAbort(target, ver, skipBuy)
	if ver ~= flameVersion then return end
	if target and not isPlayerGone(target) then
		flamePendingTarget = target
		flamePendingSkipBuy = skipBuy == true
	end
	flameAttached = false
	flameTarget = nil
end

local function runFlameVoidPhase(koSavedPlayer, koSavedChar, version)
	task.spawn(function()
		local lp = game.Players.LocalPlayer
		local RunService = game:GetService("RunService")
		local vDied = false
		local vConn
		vConn = RunService.Heartbeat:Connect(function()
			if version ~= flameVersion then vConn:Disconnect() return end
			if isPlayerGone(koSavedPlayer) then vConn:Disconnect() return end
			if isSelfDead() then
				vDied = true
				vConn:Disconnect()
				return
			end
			local vChar = lp.Character
			local vHrp = vChar and vChar:FindFirstChild("HumanoidRootPart")
			if not vHrp then return end
			vHrp.CFrame = VoidCFrame
			vHrp.AssemblyLinearVelocity = Vector3.zero
			vHrp.AssemblyAngularVelocity = Vector3.zero
		end)

		local waited = 0
		while version == flameVersion and not vDied do
			if isPlayerGone(koSavedPlayer) then break end
			local vc = koSavedPlayer.Character
			if vc and vc.Parent and vc:FindFirstChild("HumanoidRootPart") then
				local be2 = vc:FindFirstChild("BodyEffects")
				local hum = vc:FindFirstChildOfClass("Humanoid")
				local ko2 = be2 and (be2:FindFirstChild("KO") or be2:FindFirstChild("K.O"))
				local sd2 = be2 and be2:FindFirstChild("SDeath")
				local dead2 = be2 and (be2:FindFirstChild("Dead") or be2:FindFirstChild("Death"))
				local isDead = (ko2 and ko2.Value) or (sd2 and sd2.Value) or (dead2 and dead2.Value)
				local hasFF = vc:FindFirstChildOfClass("ForceField") ~= nil
				local isAlive = hum and hum.Health > 0
				if isAlive and not isDead and not hasFF then break end
			end
			RunService.Heartbeat:Wait()
			waited = waited + 1
			if waited > 60 * 120 then break end
		end
		vConn:Disconnect()

		if vDied then
			if not isPlayerGone(koSavedPlayer) then
				flamePendingTarget = koSavedPlayer
				flamePendingSkipBuy = true
			end
			return
		end

		if isPlayerGone(koSavedPlayer) then return end

		if version == flameVersion then
			flameAttached = false
			flameTarget = nil
			task.wait(0.2)
			if version == flameVersion then
				flameStartAttack(koSavedPlayer, true, version)
			end
		end
	end)
end
flameStartAttack = function(target, skipBuy, version)
	if flameAttached or version ~= flameVersion or not target then return end
	if isPlayerGone(target) then return end

	local lp = game.Players.LocalPlayer

	if isSelfDead() then
		savePendingAndAbort(target, version, skipBuy)
		return
	end

	flameAttached = true

	task.spawn(function()
		if not skipBuy or not (lp.Backpack:FindFirstChild("[Flamethrower]") or lp.Character:FindFirstChild("[Flamethrower]")) then
			while flameAttached and version == flameVersion do
				if isPlayerGone(target) then flameAttached = false return end
				if isSelfDead() then savePendingAndAbort(target, version, false) return end
				if lp.Backpack:FindFirstChild("[Flamethrower]") or lp.Character:FindFirstChild("[Flamethrower]") then break end
				local item = workspace:FindFirstChild("[Flamethrower] - $10130", true)
				if item then
					lp.Character.HumanoidRootPart.CFrame = item:GetPivot()
					task.wait(0.1)
					lp.Character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
					lp.Character.HumanoidRootPart.AssemblyAngularVelocity = Vector3.zero
					fireclickdetector(item:FindFirstChildWhichIsA("ClickDetector", true))
				end
				task.wait(0.1)
			end
			if not flameAttached or version ~= flameVersion then flameAttached = false return end

			for _ = 1, 5 do
				if not flameAttached or version ~= flameVersion then return end
				if isPlayerGone(target) then flameAttached = false return end
				if isSelfDead() then savePendingAndAbort(target, version, false) return end
				local item = workspace:FindFirstChild("140 [Flamethrower Ammo] - $1126", true)
				if item then
					lp.Character.HumanoidRootPart.CFrame = item:GetPivot()
					task.wait(0.1)
					lp.Character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
					lp.Character.HumanoidRootPart.AssemblyAngularVelocity = Vector3.zero
					fireclickdetector(item:FindFirstChildWhichIsA("ClickDetector", true))
				end
				task.wait(0.2)
			end
			if not flameAttached or version ~= flameVersion then flameAttached = false return end
		end

		local char = lp.Character
		if not lp.Backpack:FindFirstChild("[Flamethrower]") and not char:FindFirstChild("[Flamethrower]") then
			flameAttached = false return
		end

		char.Humanoid:EquipTool(lp.Backpack:FindFirstChild("[Flamethrower]") or char:FindFirstChild("[Flamethrower]"))
		if not flameAttached or version ~= flameVersion then flameAttached = false return end
		setFlameGrip(FLAME_GRIP_ACTIVE)

		pcall(function()
			char.Humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
			char.Humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
		end)

		for _, a in pairs(char.Humanoid:GetPlayingAnimationTracks()) do
			if a.Name ~= "LeftAim" then pcall(function() a:Stop() end) end
		end

		flameTarget = target

		while flameAttached and version == flameVersion do
			-- ============================================================
			-- Guard 1: target player gone / self dead / target char missing / target dead
			-- (previously used `continue`)
			-- ============================================================
			local tChar = nil
			local skipThisIteration = false

			if isPlayerGone(flameTarget) then
				flameAttached = false flameTarget = nil
				skipThisIteration = true
			end

			if not skipThisIteration then
				char = lp.Character
				if isSelfDead() then
					savePendingAndAbort(flameTarget, version, true)
					skipThisIteration = true
				end
			end

			if not skipThisIteration then
				tChar = flameTarget.Character
				if not tChar or not tChar.Parent then
					task.wait(0.3)
					skipThisIteration = true -- was: continue
				end
			end

			if not skipThisIteration then
				if isTargetDead(tChar) then
					flameAttached = false flameTarget = nil
					skipThisIteration = true
				end
			end

			-- ============================================================
			-- Main body (only runs when not skipped)
			-- ============================================================
			if not skipThisIteration then
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				local tHrp = tChar:FindFirstChild("HumanoidRootPart")

				if isTargetKO(tChar) then
					local t = char:FindFirstChild("[Flamethrower]")
					if t then
						setFlameGrip(FLAME_GRIP_DEFAULT)
						t.Parent = lp.Backpack
					end
				else
					if lp.Backpack:FindFirstChild("[Flamethrower]") then
						char.Humanoid:EquipTool(lp.Backpack["[Flamethrower]"])
						setFlameGrip(FLAME_GRIP_ACTIVE)
					end
					if char:FindFirstChild("[Flamethrower]") then
						char["[Flamethrower]"]:Activate()
					end
					for _, a in pairs(char.Humanoid:GetPlayingAnimationTracks()) do
						if a.Name ~= "LeftAim" then pcall(function() a:Stop() end) end
					end
				end

				if hrp and tHrp then
					if not hrp:IsGrounded() and version == flameVersion then
						local origMat = tHrp.Material
						local origAnchored = tHrp.Anchored
						local origCollide = tHrp.CanCollide
						local origProps = tHrp.CustomPhysicalProperties
						local origParent = tHrp.Parent
						local origCF = tHrp.CFrame
						local baseParent = hrp.Parent
						local baseCollide = hrp.CanCollide
						local baseName = hrp.Name
						local baseProps = hrp.CustomPhysicalProperties
						local holderModel = Instance.new("Model", workspace)
						local holderHum = Instance.new("Humanoid", holderModel)
						holderHum.RequiresNeck = false
						holderHum.BreakJointsOnDeath = false
						holderHum.HipHeight = FLAME_HOLDER_OFFSET
						for _, state in pairs(Enum.HumanoidStateType:GetEnumItems()) do
							if state ~= Enum.HumanoidStateType.None and state ~= Enum.HumanoidStateType.Running then
								holderHum:SetStateEnabled(state, false)
								holderHum:ChangeState(Enum.HumanoidStateType.Running)
							end
						end
						tHrp.Material = Enum.Material.ClayRoofTiles
						tHrp.Parent = workspace
						tHrp.CustomPhysicalProperties = PhysicalProperties.new(100, 0, 0)
						tHrp.Anchored = false
						tHrp.CanCollide = true
						hrp.CanCollide = false
						hrp.Name = "HumanoidRootPart"
						hrp.CustomPhysicalProperties = PhysicalProperties.new(0.001, 0, 0)
						hrp.Parent = holderModel
						local koSavedChar, koSavedPlayer = nil, nil
						local currentCF = origCF
						repeat
							if not flameAttached or version ~= flameVersion then break end
							if isPlayerGone(flameTarget) then
								flameAttached = false flameTarget = nil break
							end
							if isSelfDead() then
								savePendingAndAbort(flameTarget, version, true)
								break
							end
							if not flameTarget or not flameTarget.Character or not flameTarget.Character.Parent then
								flameAttached = false flameTarget = nil break
							end
							local c = flameTarget.Character
							if isTargetDead(c) then flameAttached = false flameTarget = nil break end
							if isTargetKO(c) then
								local ft = char:FindFirstChild("[Flamethrower]")
								if ft then ft.Parent = lp.Backpack end
								koSavedChar = c koSavedPlayer = flameTarget
								flameAttached = false flameTarget = nil break
							end
							holderHum:ChangeState(Enum.HumanoidStateType.Running)
							if c:FindFirstChild("HumanoidRootPart") then
								currentCF = c.HumanoidRootPart.CFrame
							end
							tHrp.CFrame = CFrame.new(currentCF.Position)
							tHrp.AssemblyLinearVelocity = Vector3.zero
							tHrp.AssemblyAngularVelocity = Vector3.zero
							hrp.CFrame = tHrp.CFrame * CFrame.new(0, FLAME_HOLDER_OFFSET, 0)
							hrp.AssemblyLinearVelocity = Vector3.zero
							hrp.AssemblyAngularVelocity = Vector3.zero
							game:GetService("RunService").Heartbeat:Wait()
						until holderHum.FloorMaterial == tHrp.Material
							or not flameAttached
							or version ~= flameVersion
							or (flameTarget and flameTarget.Character and flameTarget.Character:FindFirstChild("HumanoidRootPart")
								and (hrp.Position - flameTarget.Character.HumanoidRootPart.Position).Magnitude < FLAME_HOLDER_OFFSET + 1)

						holderHum:Destroy()
						pcall(function()
							if hrp and hrp.Parent then
								hrp.Parent = baseParent hrp.Name = baseName
								hrp.CustomPhysicalProperties = baseProps hrp.CanCollide = baseCollide
							end
						end)
						holderModel:Destroy()
						pcall(function()
							if tHrp and tHrp.Parent then
								tHrp.Parent = origParent tHrp.Anchored = origAnchored
								tHrp.Material = origMat tHrp.CustomPhysicalProperties = origProps
								tHrp.CanCollide = origCollide tHrp.CFrame = currentCF
							end
						end)

						if koSavedChar then
							task.spawn(function()
								task.wait(0.05)
								if version ~= flameVersion or not koSavedChar:FindFirstChild("UpperTorso") then return end
								local ft = lp.Character and lp.Character:FindFirstChild("[Flamethrower]")
								if ft then ft.Parent = lp.Backpack end
								local glueConn
								glueConn = game:GetService("RunService").Heartbeat:Connect(function()
									if version ~= flameVersion then glueConn:Disconnect() return end
									if isPlayerGone(koSavedPlayer) then glueConn:Disconnect() return end
									if isSelfDead() then
										if not isPlayerGone(koSavedPlayer) then
											flamePendingTarget = koSavedPlayer
											flamePendingSkipBuy = true
										end
										glueConn:Disconnect() return
									end
									local glueChar = lp.Character
									if not glueChar or not glueChar.Parent then
										if not isPlayerGone(koSavedPlayer) then
											flamePendingTarget = koSavedPlayer
											flamePendingSkipBuy = true
										end
										glueConn:Disconnect() return
									end
									if isTargetSDeath(koSavedChar) or isTargetDead(koSavedChar) then
										glueConn:Disconnect()
										if version == flameVersion and not isPlayerGone(koSavedPlayer) then
											runFlameVoidPhase(koSavedPlayer, koSavedChar, version)
										end
										return
									end

									-- target got back up — re-engage
									if not isTargetKO(koSavedChar) then
										glueConn:Disconnect()
										if version == flameVersion and not isPlayerGone(koSavedPlayer) then
											flameAttached = false
											flameTarget = nil
											task.wait(0.1)
											flameStartAttack(koSavedPlayer, true, version)
										end
										return
									end

									if isTargetKO(koSavedChar) then
										ReplicatedStorage.MainEvent:FireServer("Stomp")
									end
									local glHrp = glueChar:FindFirstChild("HumanoidRootPart")
									local glUt = koSavedChar:FindFirstChild("UpperTorso")
									if glHrp and glUt then
										local _, ry, _ = glHrp.CFrame:ToOrientation()
										glHrp.CFrame = CFrame.new(glUt.Position + Vector3.new(0, FLAME_STOMP_OFFSET, 0)) * CFrame.Angles(0, ry, 0)
										glHrp.AssemblyLinearVelocity = Vector3.zero
										glHrp.AssemblyAngularVelocity = Vector3.zero
									else
										glueConn:Disconnect()
									end
								end)
							end)
						end
					end
				else
					task.wait(0.5)
				end
			end
			-- if skipThisIteration is true, loop naturally continues to next iteration
		end
		setFlameGrip(FLAME_GRIP_DEFAULT)
		flameAttached = false flameTarget = nil
	end)
end

