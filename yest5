RunService.RenderStepped:Connect(function()
    if not SA.on then
        fovFrame.Visible = false
        SA.locked = nil
        return
    end
    local m = getAimPoint()
    local rad = math.tan(math.rad(math.min(SA.fov/2, 89))) / math.tan(math.rad(Camera2.FieldOfView/2)) * (Camera2.ViewportSize.Y/2)
    local best, bd = nil, rad
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local part = saPart(p.Character)
            local be = p.Character:FindFirstChild("BodyEffects")
            local ko = be and (be:FindFirstChild("K.O") or be:FindFirstChild("KO"))
            if part and not (SA.noKO and ko and ko.Value) and saVisible(part) then
                local sp, vis = Camera2:WorldToViewportPoint(part.Position)
                if vis and sp.Z > 0 then
                    local d = (Vector2.new(sp.X, sp.Y) - m).Magnitude
                    if d <= bd then bd = d best = part end
                end
            end
        end
    end
    SA.locked = best
    if SA.ring then
        fovFrame.Visible = true
        fovFrame.Size = UDim2.fromOffset(rad*2, rad*2)
        fovFrame.Position = getRingPosition(m)
    else
        fovFrame.Visible = false
    end
end)

