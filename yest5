                end
            end
            bagVisualizer.Parent = workspace
        end
        if bagVisualizer then
            bagVisualizer:PivotTo(cframe)
            if realRoot then
                if not attReal then
                    attReal = Instance.new("Attachment")
                    attReal.Name = "VisualizerAttReal"
                    attReal.Parent = realRoot
                end
                local visRoot = bagVisualizer:FindFirstChild("HumanoidRootPart")
                if visRoot then
                    if not attVisual then
                        attVisual = Instance.new("Attachment")
                        attVisual.Name = "VisualizerAttVis"
                        attVisual.Parent = visRoot
                    end
                    if not bagBeam then
                        bagBeam = Instance.new("Beam")
                        bagBeam.Name = "BagVisualizerBeam"
                        bagBeam.Attachment0 = attReal
                        bagBeam.Attachment1 = attVisual
                        bagBeam.FaceCamera = true
                        bagBeam.Width0 = 0.15
                        bagBeam.Width1 = 0.15
                        bagBeam.Transparency = NumberSequence.new(0.2)
                        bagBeam.Parent = workspace
                    end
                    bagBeam.Color = ColorSequence.new(color or Color3.fromRGB(139,69,19))
                end
            end
        end
    else
        if bagBeam then bagBeam:Destroy() bagBeam = nil end
        if attReal then attReal:Destroy() attReal = nil end
        if attVisual then attVisual:Destroy() attVisual = nil end
        if bagVisualizer then bagVisualizer:Destroy() bagVisualizer = nil end
    end
end


