Main:AddToggle("VelocityFly", {
    Text = "Velocity Fly", Default = false,
    Keybind = Enum.KeyCode.Unknown, KeybindRequiresToggle = true, KeybindPicker = true,
    Callback = function(state)
        IsFlying = state
        if state then
            Notify("Velocity Fly Enabled", 2)
            FlyLoop = RunService.Heartbeat:Connect(function()
                local c = LocalPlayer.Character
                local hrp = c and c:FindFirstChild('HumanoidRootPart')
                local hum = c and c:FindFirstChildOfClass('Humanoid')
                if not (hrp and hum) then return end
                local animate = c:FindFirstChild("Animate")
                if animate and not animate.Disabled then
                    animate.Disabled = true
                    for _, t in ipairs(hum:GetPlayingAnimationTracks()) do t:Stop() end
                end
                local md = hum.MoveDirection
                if md.Magnitude > 0 then
                    local cf = Camera2.CFrame
                    local fl = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
                    fl = fl.Magnitude > 0 and fl.Unit or Vector3.new(0,0,-1)
                    local fr = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z)
                    fr = fr.Magnitude > 0 and fr.Unit or Vector3.new(1,0,0)
                    local mv = (cf.LookVector * md:Dot(fl)) + (cf.RightVector * md:Dot(fr))
                    hrp.Velocity = mv.Magnitude > 0 and (mv.Unit * FlySpeed) or Vector3.zero
                else
                    hrp.Velocity = Vector3.zero
                end
            end)
        else
            Notify("Velocity Fly Disabled", 1.5)
            if FlyLoop then FlyLoop:Disconnect() FlyLoop = nil end
            local c = LocalPlayer.Character
            if c then
                local a = c:FindFirstChild("Animate")
                if a then a.Disabled = false end
                local h = c:FindFirstChildOfClass('Humanoid')
                if h then h:ChangeState(Enum.HumanoidStateType.Standing) end
            end
        end
    end
})
