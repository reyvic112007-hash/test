function getTargetClosestToMouse()
    local m = LocalPlayer:GetMouse()
    local best, bd = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local tpart = p.Character:FindFirstChild("UpperTorso") or p.Character:FindFirstChild("Torso") or p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local be = p.Character:FindFirstChild("BodyEffects")
            local ko = be and be:FindFirstChild("K.O") and be["K.O"].Value == true
            local dead = be and be:FindFirstChild("Dead") and be.Dead.Value == true
            if tpart and hum and hum.Health > 0 and ko and not dead then
                local sp, on = Camera2:WorldToViewportPoint(tpart.Position)
                if on then
                    local d = (Vector2.new(m.X,m.Y) - Vector2.new(sp.X,sp.Y)).Magnitude
                    if d < bd then bd = d best = p end
                end
            end
        end
    end
    return best
end

function getTargetNearby()
    local root = LocalPlayer.Character and (LocalPlayer.Character:FindFirstChild("HumanoidRootPart") or LocalPlayer.Character:FindFirstChild("Torso"))
    if not root then return end
    local best, bd = nil, stompState.nearbyRange
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local tpart = p.Character:FindFirstChild("UpperTorso") or p.Character:FindFirstChild("Torso") or p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local be = p.Character:FindFirstChild("BodyEffects")
            local ko = be and be:FindFirstChild("K.O") and be["K.O"].Value == true
            local dead = be and be:FindFirstChild("Dead") and be.Dead.Value == true
            if tpart and hum and hum.Health > 0 and ko and not dead then
                local d = (root.Position - tpart.Position).Magnitude
                if d <= bd then bd = d best = p end
            end
        end
    end
    return best
end

function runFastStomp()
    if not stompState.enabled or stompState.active then return end
    local tp = getTargetClosestToMouse()
    if not tp or not tp.Character then return end
    local tChar = tp.Character
    local tTorso = tChar:FindFirstChild("UpperTorso") or tChar:FindFirstChild("Torso") or tChar:FindFirstChild("HumanoidRootPart")
    if not tTorso then return end
    if not beginStompCamera() then return end
    stompState.active = true
    togglePhysicsRep(true)
    Notify("Stomping "..tp.DisplayName, 3, tp.UserId)
    task.spawn(function()
        while stompState.enabled and stompState.active and tChar and tChar.Parent do
            local be = tChar:FindFirstChild("BodyEffects")
            local dead = be and be:FindFirstChild("Dead") and be.Dead.Value == true
            local ko = be and be:FindFirstChild("K.O") and be["K.O"].Value == true
            if dead or not ko then Notify("Target Stomped", 2) break end
            stompState.targetCFrame = CFrame.new(tTorso.Position + Vector3.new(0,3,0))
            ReplicatedStorage.MainEvent:FireServer("Stomp")
            RunService.Heartbeat:Wait()
        end
        stopStompAction()
    end)
end
function runNearbyStompLoop()
    task.spawn(function()
        while stompState.nearbyEnabled do
            if not stompState.active then
                local tp = getTargetNearby()
                if tp and tp.Character then
                    local tChar = tp.Character
                    local tTorso = tChar:FindFirstChild("UpperTorso") or tChar:FindFirstChild("Torso") or tChar:FindFirstChild("HumanoidRootPart")
                    if tTorso then
                        if beginStompCamera() then
                            stompState.active = true
                            togglePhysicsRep(true)
                            Notify("Auto-Stomping: "..tp.DisplayName, 3)
                            while stompState.nearbyEnabled and stompState.active and tChar and tChar.Parent do
                                local be = tChar:FindFirstChild("BodyEffects")
                                local dead = be and be:FindFirstChild("Dead") and be.Dead.Value == true
                                local ko = be and be:FindFirstChild("K.O") and be["K.O"].Value == true
                                if dead or not ko then
                                    Notify("Nearby Target Stomped", 2)
                                    break
                                end
                                stompState.targetCFrame = CFrame.new(tTorso.Position + Vector3.new(0,3,0))
                                ReplicatedStorage.MainEvent:FireServer("Stomp")
                                RunService.Heartbeat:Wait()
                            end
                            stopStompAction()
                        else
                            task.wait(0.1)
                        end
                    end
                end
            end
            task.wait(0.1)
        end
    end)
end
