-- Camera stays on the Humanoid the entire time — no subject swap, no head offset.
-- We compensate the teleport with Humanoid.CameraOffset so the camera's focus
-- point stays exactly where it was, and the camera keeps following you as you walk.
RunService.Heartbeat:Connect(function()
    if not csync.enabled or not csync.tpPos or not csync.target then return end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild('HumanoidRootPart')
    local humanoid = char and char:FindFirstChild('Humanoid')
    if not root or not humanoid then return end
    csync.old = root.CFrame
    if csync.mode == 'Default' then
        local rot    = csync.old - csync.old.Position
        local oldPos = csync.old.Position
        local tpPos  = csync.tpPos

        -- offset is in HumanoidRootPart-local space; with the root rotated back
        -- to `rot` during the teleport, the camera's focus becomes
        --   CFrame.new(tpPos) * rot * CFrame.new(offset)
        -- = CFrame.new(oldPos) * rot
        -- i.e. exactly where it was before the teleport. Camera sees nothing.
        humanoid.CameraOffset = rot:VectorToObjectSpace(oldPos - tpPos)
        root.CFrame = CFrame.new(tpPos) * rot
        RunService.RenderStepped:Wait()
        root.CFrame = csync.old
        humanoid.CameraOffset = Vector3.zero
    end
end)

